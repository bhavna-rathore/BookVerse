# MongoDB connection string (Atlas or local)
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bookverse

# Secret used to sign/verify JWTs — required, generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional
PORT=5000

# One-time data seeding flags — leave commented out in normal use
# SEED=true
# SEED_CATEGORIES=true
