# Node dependencies
node_modules/

# Environment variables
.env

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# Build / runtime files
dist/
build/
.tmp/
coverage/

# User-uploaded images — runtime artifacts, not source. Keep the directory
